{
  "custom_liquid_cLN3Mj": {
    "type": "custom-liquid",
    "custom_css": [
      ".bfx{font-size:17px;padding:12px 16px 6px}",
      ".bfx__d b{font-size:24px}"
    ],
    "name": "Custom HTML/Liquid",
    "settings": {
      "custom_liquid": "{%- comment -%}Black Friday extras, added in the theme editor 13 Nov 2026. Countdown bar on collection and product pages; makes the hero badge (home) and the banner badge (kitchen collections) link to the Black Friday page. Remove this section when the sale ends.{%- endcomment -%}{%- if template.name == 'collection' or template.name == 'product' -%}<a class=\"bfx\" href=\"/pages/black-friday\" data-bfx-end=\"2026-11-28T23:59:59+11:00\"><span class=\"bfx__t\">Black Friday ends in</span><span class=\"bfx__d\"><b data-u=\"d\">00</b> days <b data-u=\"h\">00</b> hrs <b data-u=\"m\">00</b> min <b data-u=\"s\">00</b> sec</span><span class=\"bfx__c\">Shop the deals</span></a><style>.bfx{display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:2px 16px;padding:10px 16px 4px;background:#141414;color:#fff;font-size:14px;line-height:1.3;text-align:center;text-decoration:none}.bfx[hidden]{display:none}.bfx:hover{color:#fff}.bfx__t{font-weight:700;text-transform:uppercase}.bfx__d b{display:inline-block;min-width:1.4em;font-size:18px;font-variant-numeric:tabular-nums}.bfx__c{font-weight:700;text-decoration:underline;text-underline-offset:3px}.collection-banner{position:relative}.bfx-link{position:absolute;top:0;right:0;bottom:0;width:50%}@media (max-width:767px){.bfx__c,.bfx-link{display:none}}</style><script>(function(){var bar=document.querySelector('.bfx'),end=Date.parse(bar.getAttribute('data-bfx-end')),u={},t;bar.querySelectorAll('[data-u]').forEach(function(e){u[e.getAttribute('data-u')]=e});var p=function(n){return String(n).padStart(2,'0')};var tick=function(){var l=Math.floor((end-Date.now())/1000);if(!(l>0)){bar.hidden=true;clearInterval(t);return}u.d.textContent=p(Math.floor(l/86400));u.h.textContent=p(Math.floor(l/3600)%24);u.m.textContent=p(Math.floor(l/60)%60);u.s.textContent=p(l%60)};tick();t=setInterval(tick,1000)})();</script>{%- endif -%}{%- if template.name == 'index' or template.suffix == 'kitchens' -%}<script>document.addEventListener('DOMContentLoaded',function(){var a=document.createElement('a');a.href='/pages/black-friday';a.setAttribute('aria-label','Black Friday sale: shop the deals');{%- if template.name == 'index' -%}var h=document.querySelector('.cbf-hero__badge');a.style.cssText='position:absolute;inset:16%;border-radius:50%';{%- else -%}var h=document.querySelector('.collection-banner');a.className='bfx-link';{%- endif -%}if(h)h.appendChild(a)});</script>{%- endif -%}",
      "section_height": "tight",
      "full_width": true,
      "dividers": "none",
      "prevent_animation": true
    }
  }
